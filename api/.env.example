# Provedor/modelo padrão do agente (ver api/src/llm/config)
LLM_DEFAULT_PROVIDER=anthropic
# LLM_DEFAULT_MODEL=claude-sonnet-5
LLM_DEFAULT_TEMPERATURE=0.7
# LLM_DEFAULT_MAX_TOKENS=2048

# Subagente de reflexão de estado pós-turno (atualiza descrição de sessão/cena).
# Opcionais — default abaixo. Exige ANTHROPIC_API_KEY; se faltar, a reflexão
# vira no-op silencioso.
# LLM_REFLECTION_PROVIDER=anthropic
# LLM_REFLECTION_MODEL=claude-haiku-4-5

# API keys — preencha ao menos a do provedor padrão
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
